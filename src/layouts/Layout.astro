---
import SEO from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
import { AuthProvider } from "../context/AuthContext";
import { TokenProvider } from "../context/TokenContext";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    keywords?: string;
    includeResumeStyles?: boolean;
    noindex?: boolean;
}

const { title, description, image, keywords, includeResumeStyles = false, noindex = false } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/logo.png" />
        <meta name="generator" content={Astro.generator} />

        <SEO
            title={title}
            description={description}
            image={image}
            keywords={keywords}
            noindex={noindex}
        />
        <Analytics />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Merriweather:wght@300;400;700;900&family=Tinos:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Merriweather:wght@300;400;700;900&family=Tinos:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Merriweather:wght@300;400;700;900&family=Tinos:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;700&display=swap"
                rel="stylesheet"
            />
        </noscript>
        {includeResumeStyles && <link rel="preload" href="/resume.css" as="style" />}
        {includeResumeStyles && <link rel="stylesheet" href="/resume.css" />}
        <script is:inline>
            // Immediate theme application to prevent flash
            // This local session hint only selects the homepage view; it never
            // authorizes an API request or exposes protected server data.
            const hasHomepageSession = (() => {
                if (window.location.pathname !== "/") return false;
                try {
                    const token = localStorage.getItem("auth_token");
                    const user = JSON.parse(localStorage.getItem("user") || "null");
                    const loginTime = Number(localStorage.getItem("login_time"));
                    const loginAge = Date.now() - loginTime;
                    return Boolean(token && user && typeof user === "object" && typeof user.email === "string" && user.email
                        && loginTime > 0 && loginAge >= 0 && loginAge <= 3 * 24 * 60 * 60 * 1000);
                } catch {
                    return false;
                }
            })();
            if (hasHomepageSession) document.documentElement.classList.add("resume-editor-home");

            const theme = (() => {
                const isHomepage = window.location.pathname === "/";
                try {
                    const savedTheme = localStorage.getItem("theme");
                    if (savedTheme === "light" || savedTheme === "dark") return savedTheme;

                    if (hasHomepageSession) return "dark";
                } catch {
                    // Missing or inaccessible storage should not block rendering.
                }
                return isHomepage ? "light" : "dark";
            })();

            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body>
        <AuthProvider client:load>
        <TokenProvider>
            <slot />
        </TokenProvider>
    </AuthProvider>
    </body>
</html>

<script>
    import { captureCampaignAttribution, trackCampaignEvent } from '../lib/campaign';
    captureCampaignAttribution();
    trackCampaignEvent('page_view');
    const params = new URLSearchParams(window.location.search);
    const editorEntry = ['edit', 'new', 'ai', 'view', 'application'].some((key) => params.has(key));
    if (window.location.pathname === '/' && !editorEntry && window.location.hash !== '#builder' && !document.documentElement.classList.contains('resume-editor-home')) {
        trackCampaignEvent('landing_view', { page: 'home' });
    }
    document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-campaign-cta]') : null;
        if (link) {
            trackCampaignEvent('landing_cta_clicked', {
                action: link.dataset.campaignCta,
                destination: new URL(link.href).pathname + new URL(link.href).hash,
                page: 'home',
            });
        }
    });
</script>
