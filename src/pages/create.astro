---
import Layout from '../layouts/Layout.astro';
import { CreateOptions } from '../components/ui/CreateDocument';
export const prerender = true;
---

<Layout
    title="Create a Resume or CV | ResumeVibe"
    description="Start a resume, a one-page resume, or an academic CV, or begin from an example."
    noindex
>
    <main class="min-h-screen bg-[var(--bg-main)] px-5 py-12 text-[var(--text-main)] sm:px-8 sm:py-16">
        <div class="mx-auto flex max-w-5xl flex-col gap-12">
            <div class="flex flex-col gap-10">
                <a href="/editor" class="w-fit text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)]">← Back to editor</a>
                <header class="flex flex-col gap-3">
                    <p class="rv-kicker">New document</p>
                    <h1 class="font-serif-ed text-5xl leading-tight sm:text-6xl">What would you like to create?</h1>
                    <p class="max-w-2xl text-sm leading-7 text-[var(--text-muted)]">Every format uses the same editor, AI Copilot, autosave, version history, and PDF export. You can add or remove sections at any time.</p>
                </header>
            </div>
            <CreateOptions />
        </div>
    </main>
</Layout>
