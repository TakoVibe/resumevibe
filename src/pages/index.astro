---
export const prerender = true;
import { ResumeBuilder } from "../components/ResumeBuilder";
import HomeLanding from "../components/home/HomeLanding.astro";
import Layout from "../layouts/Layout.astro";
import { Footer } from "../components/ui/Footer";
---

<Layout
    title="ResumeVibe by TakoVibe | Engineering Resume Builder & Job-Fit Check"
    description="Build your engineering resume and export a PDF for free. No account or job description is needed to start editing. Sign in to import or save online; job-fit comparison is optional."
    includeResumeStyles
>
    <HomeLanding />
    <!-- Keep the editor on its original URL so saved documents and old links work. -->
    <section id="builder" aria-label="Free resume builder" class="relative h-[100dvh] overflow-hidden border-t border-[var(--border-color)]" style="contain: layout paint; isolation: isolate;">
        <ResumeBuilder client:visible />
    </section>
    <div class="homepage-footer"><Footer /></div>
</Layout>

<style>
    /* Applied before paint so the visible editor can hydrate immediately. */
    :global(html.resume-editor-home .rv-home),
    :global(html.resume-editor-home .homepage-footer) {
        display: none;
    }

    :global(html.resume-editor-home #builder) {
        border-top: 0;
    }
</style>

<script>
    // Shared document/tool links keep opening the editor directly.
    const params = new URLSearchParams(window.location.search);
    const isEditorLink = ['edit', 'new', 'ai', 'view', 'application'].some((key) => params.has(key));
    if (isEditorLink && !window.location.hash) {
        document.getElementById('builder')?.scrollIntoView();
    }
</script>
