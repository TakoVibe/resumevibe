# Existing application services. Use development credentials locally.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Optional Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# Leave empty to keep third-party analytics disabled. Rebuild after changing.
PUBLIC_GA_MEASUREMENT_ID=

# Optional HTML verification token from a Search Console URL-prefix property.
PUBLIC_GOOGLE_SITE_VERIFICATION=
