---
interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonicalURL?: URL | string;
    type?: string;
    keywords?: string;
    noindex?: boolean;
}

const {
    title = "ResumeVibe by TakoVibe | Free Resume Builder & Job-Fit Check",
    description = "Build your engineering resume, compare it with a job, review suggested edits, and export your PDF. ResumeVibe is built by Rahul Beniwal at TakoVibe.",
    image = "/og-image.png",
    canonicalURL = new URL(Astro.url.pathname, Astro.site),
    type = "website",
    keywords = "engineering resume builder, resume job fit checker, tailor resume to job description, free resume builder",
    noindex = false,
} = Astro.props;

const siteName = "ResumeVibe by TakoVibe";
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const siteURL = new URL("/", Astro.site || "https://resumevibe.takovibe.com");
const pageTitle = title.includes("by TakoVibe") ? title : title.replace("ResumeVibe", siteName);
const canonical = new URL(canonicalURL, siteURL);
const imageURL = new URL(image, siteURL);
const structuredData = [
    ...(Astro.url.pathname === "/" ? [
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "@id": new URL("#website", siteURL).href,
            name: siteName,
            alternateName: ["ResumeVibe", "resumevibe.takovibe.com"],
            url: siteURL.href,
            publisher: { "@id": "https://takovibe.com/#organization" },
        },
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "@id": "https://takovibe.com/#organization",
            name: "TakoVibe",
            url: "https://takovibe.com/",
            logo: new URL("/takovibe_logo.svg", siteURL).href,
        },
        {
            "@context": "https://schema.org",
            "@type": "WebApplication",
            name: siteName,
            url: siteURL.href,
            applicationCategory: "BusinessApplication",
            operatingSystem: "Web",
            description: "A resume editor and job-fit comparison for engineers. Building and PDF export are free; additional AI features use VibeTokens.",
            offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
            creator: {
                "@type": "Person",
                name: "Rahul Beniwal",
                url: "https://rahulbeniwal.takovibe.com/",
            },
        },
    ] : []),
];
---

<link rel="manifest" href="/manifest.json" />
<link rel="canonical" href={canonical} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{structuredData.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
)}
